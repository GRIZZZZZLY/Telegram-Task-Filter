# ===== Telegram / Telethon =====
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_NAME=user

# Chat filters (comma-separated)
# Example: -1002512649185,-1001234567890
TG_MONITORED_CHAT_IDS=

# Thread/topic filter (optional)
# Example: 173,293,294
TG_MONITORED_THREAD_IDS=

# Mention trigger
TG_MENTION_HANDLE=@LindsyQQ

# ===== Backend =====
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8787
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change_me

# ===== Database =====
DB_URL=sqlite:///./data/focus_filter.db

# ===== Rule engine =====
RULES_PATH=./shared/rules/default_rules.yaml
DEDUP_SIMILARITY_THRESHOLD=0.88

# ===== Reactions =====
# Emoji reaction when task is marked done
DONE_REACTION=✅

# ===== UI / CORS =====
UI_ORIGIN=http://localhost:1420

# ===== Optional AI (future) =====
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ===== Observability =====
METRICS_ENABLED=false
