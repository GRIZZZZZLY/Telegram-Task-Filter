# ===== Telegram / Telethon =====
TG_API_ID=
TG_API_HASH=
TG_PHONE=+79991234567
TG_SESSION_NAME=user

# Chat filters (comma-separated supergroup IDs; get them via Settings → Chat Selector)
# Example: -1002512649185,-1001234567890
TG_MONITORED_CHAT_IDS=

# Thread/topic filter within monitored chats (optional, comma-separated)
# Example: 173,293,294
TG_MONITORED_THREAD_IDS=

# Mention trigger — comma-separated handles (preferred multi-handle form)
# Example: @yourhandle,@alias
TG_MENTION_HANDLES=@yourhandle
# Legacy single-handle fallback (used if TG_MENTION_HANDLES is empty)
# TG_MENTION_HANDLE=@yourhandle

# ===== Backend =====
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8787
APP_LOG_LEVEL=INFO

# ===== Database =====
DB_URL=sqlite:///./data/focus_filter.db

# ===== Rule engine =====
RULES_PATH=./shared/rules/default_rules.yaml
# Note: DEDUP_SIMILARITY_THRESHOLD is reserved for future use, not active yet
# DEDUP_SIMILARITY_THRESHOLD=0.88

# ===== Reactions =====
# Emoji reaction sent when a task is marked Done.
# IMPORTANT: Must be a valid Telegram reaction emoji (e.g. 👍 ❤️ 🎉 🔥 💯).
# ✅ is NOT supported by Telegram as a reaction — using it will silently fail.
DONE_REACTION=👍

# Whether to send a text reply when marking a task Done (true/false)
DONE_SEND_REPLY=true
# Default reply text (used when no custom reply is entered)
DONE_REPLY_TEXT=Принял, сделаю

# Seconds to wait before committing a Done reaction (allows undo window)
DONE_COMMIT_DELAY_SECONDS=5

# ===== Filters =====
# Ignore messages sent by yourself
FILTER_IGNORE_OWN=true
# Minimum message length to consider (characters)
FILTER_MIN_TEXT_LENGTH=5
# Only trigger on messages that explicitly mention your handle (always true, cannot be disabled)
FILTER_STRICT_MENTIONS=true

# ===== Cleanup =====
# Auto-delete Done tasks after N days (0 = never)
CLEANUP_DONE_AFTER_DAYS=30

# ===== Catchup / History scan =====
# Hours of message history to scan on first launch
CATCHUP_HOURS=24

# ===== UI / CORS =====
UI_ORIGIN=http://localhost:1420

# ===== GitHub Releases / Auto-update =====
# Personal Access Token with repo scope — used by build.bat to publish releases.
# Generate at: https://github.com/settings/tokens
# Set as a system/user env var (do NOT commit the real token):
#   Windows: setx GH_TOKEN "ghp_xxxxxxxxxxxx"
# GH_TOKEN=

# ===== Optional AI (future — not implemented) =====
# AI_ENABLED=false
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=

# ===== Observability (future — not implemented) =====
# METRICS_ENABLED=false
